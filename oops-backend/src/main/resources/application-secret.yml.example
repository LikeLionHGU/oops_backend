# 이 파일을 같은 폴더에 application-secret.yml 로 복사하고 키를 채우세요.
#
#   application-secret.yml 은 .gitignore 에 있어서 깃에 올라가지 않습니다.
#   서버를 켤 때 자동으로 읽습니다. IntelliJ 실행 구성에 환경변수를 넣을 필요가 없습니다.
#
# 키가 없으면 서버는 뜨지만 LLM 분석기 4개가 전부 스킵됩니다.
#   speech-review / screen-text-review / entity-check / context-check
# 그러면 참고 자료도 안 나오고 분석이 몇 초 만에 끝납니다.
#
# 제대로 들어갔는지는 시작 로그로 확인합니다.
#   [openai] 키=sk-proj-...abcd 조직=(계정 기본값) ... 모델=gpt-4o-mini

oops:
  openai:
    api-key: sk-proj-여기에-키를-붙여넣으세요

    # 아래 둘은 대부분 비워둡니다.
    # sk-proj- 로 시작하는 프로젝트 키에는 조직·프로젝트가 이미 들어 있습니다.
    # 지원 크레딧이 특정 조직에 지급된 경우에만 채우세요.
    # organization: org-...
    # project: proj_...

  # 네이버 뉴스 검색 키 (선택).
  # 없으면 구글 뉴스 RSS 로 자동 대체되므로 안 넣어도 참고 자료는 나옵니다.
  # naver:
  #   client-id: ...
  #   client-secret: ...
