# 이 파일을 같은 폴더에 application-secret.yml 로 복사하고 키를 채우세요.
# application-secret.yml 은 .gitignore 에 있어서 깃에 올라가지 않습니다. 서버를 켤 때 자동으로 읽습니다.
# 환경변수(OPENAI_API_KEY, PERPLEXITY_API_KEY, SERPER_API_KEY, NEO4J_PASSWORD)로 넣어도 됩니다.
#
# OpenAI 키가 없으면 맥락 확인·사실대조가 둘 다 SKIPPED 로 알려집니다.
# 검색 키가 하나도 없으면 사실대조가 SKIPPED 로 알려집니다.

oops:
  openai:
    api-key: sk-proj-여기에-키를-붙여넣으세요
    # 지원 크레딧이 특정 조직에 지급된 경우에만 채우세요.
    # organization: org-...
    # project: proj_...

  # 구글 로그인 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID, 웹 애플리케이션)
  # 승인된 리디렉션 URI: {백엔드 주소}/login/oauth2/code/google  (로컬: http://localhost:8080/login/oauth2/code/google)
  auth:
    google:
      client-id: ...apps.googleusercontent.com
      client-secret: GOCSPX-...

  search:
    perplexity:
      api-key: pplx-...
    serper:
      api-key: ...

  # 서버 Neo4j 에서 기준을 읽을 때만 (oops.criteria.source=neo4j)
  # criteria:
  #   source: neo4j
  #   neo4j:
  #     password: <서버 infra/neo4j/.env 의 OOPS_DB_PASSWORD>
