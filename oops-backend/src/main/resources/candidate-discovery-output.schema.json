{
  "type": "object",
  "properties": {
    "reviewedSegmentIds": {"type": "array", "items": {"type": "string"}},
    "candidates": {"type": "array", "items": {"anyOf": [
      {"$ref": "#/$defs/proposal"}, {"$ref": "#/$defs/relationProposal"}
    ]}},
    "uncertainSegments": {"type": "array", "items": {"$ref": "#/$defs/uncertain"}},
    "truncated": {"type": "boolean"},
    "visualCandidates": {"type": "array", "items": {"$ref": "#/$defs/proposal"}}
  },
  "required": ["reviewedSegmentIds", "candidates", "uncertainSegments", "truncated", "visualCandidates"],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {"segmentId": {"type": "string"}},
      "required": ["segmentId"], "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "anchorId": {"type": "string"},
        "axis": {"type": "string", "enum": ["TARGET_TREATMENT", "EXPRESSION_CONTENT"]},
        "reason": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "required": ["anchorId", "axis", "reason", "evidence"], "additionalProperties": false
    },
    "relationProposal": {
      "type": "object",
      "properties": {
        "anchorId": {"type": "string"},
        "axis": {"type": "string", "enum": ["TARGET_TREATMENT", "EXPRESSION_CONTENT"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "sourceRelations": {"$ref": "#/$defs/relations"}
      },
      "required": ["anchorId", "axis", "evidence", "sourceRelations"], "additionalProperties": false
    },
    "relations": {
      "type": "object",
      "properties": {
        "situationIds": {"type": "array", "items": {"type": "string"}},
        "subjectIds": {"type": "array", "items": {"type": "string"}},
        "actionIds": {"type": "array", "items": {"type": "string"}},
        "evaluationIds": {"type": "array", "items": {"type": "string"}},
        "referentIds": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["situationIds", "subjectIds", "actionIds", "evaluationIds", "referentIds"],
      "additionalProperties": false
    },
    "uncertain": {
      "type": "object",
      "properties": {
        "segmentId": {"type": "string"},
        "missingInformation": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["segmentId", "missingInformation"], "additionalProperties": false
    }
  }
}
