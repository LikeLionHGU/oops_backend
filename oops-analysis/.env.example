# OpenAI whisper-1 선택 시에만 필요합니다.
OPENAI_API_KEY=sk-여기에-키
# 기본 전사 모델 Groq whisper-large-v3에 필요합니다.
GROQ_API_KEY=gsk-여기에-키
# 지원 크레딧이 특정 조직에 지급된 경우에만 채우세요 (org-...)
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
WHISPER_MODEL=whisper-large-v3
# 선택적으로 모델을 재정의할 때만 지정합니다. 예: OpenAI Whisper = whisper-1
# STT_MODEL=whisper-1
WORK_DIR=./workdir
# Spring 의 oops.storage.location 과 같은 저장소 경로.
# 기본 로컬 실행은 저장소 루트에서 oops-analysis 와 oops-backend 가 나란히 있는 구조다.
MEDIA_STORAGE_ROOT=../oops-backend/uploads

# 영상 길이 상한(초). 기본 5400 = 90분.
# 길수록 비용과 시간이 크게 늘어난다.
MAX_DURATION_SEC=5400
# default: configured duration limit. local: no duration ceiling (local worker only).
ANALYSIS_PROFILE=default

# OCR 로 인식할 최대 프레임 수. 영상이 길면 간격이 자동으로 늘어난다.
# 올리면 더 촘촘히 보지만 그만큼 느려진다.
MAX_OCR_FRAMES=300
OCR_LANG=korean
# OCR is isolated in one child process per job (one uvicorn worker recommended).
# Default deadline includes download/model/frame work: 540s; local profile:1200s.
# Keep this lower than Spring oops.analysis-server.timeout (default10m/local25m).
# OCR_TIMEOUT_SEC=1200
OCR_REC_BATCH_NUM=1

# Optional faster local test (not the default; short-lived screen text may be missed):
# MAX_OCR_FRAMES=120
# OCR_TIMEOUT_SEC=600
# Spring launch override: --oops.analysis-server.timeout=12m
# Restore MAX_OCR_FRAMES=300 and unset OCR_TIMEOUT_SEC for local20m/Spring25m baseline.
