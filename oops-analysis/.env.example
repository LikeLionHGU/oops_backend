OPENAI_API_KEY=sk-여기에-키
# 지원 크레딧이 특정 조직에 지급된 경우에만 채우세요 (org-...)
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
WHISPER_MODEL=whisper-1

# 음성 인식 제공자 (2026-10 고도화)
#   groq   (기본) Groq Whisper large-v3. https://console.groq.com 에서 키 발급. 분당 약 $0.0019
#   openai OpenAI whisper-1. OpenAI 크레딧에서 차감. 2027-02-26 에 종료된다
# groq 인데 키가 없거나 Groq 가 실패하면 위 OPENAI_API_KEY 로 대신 돌린다.
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
# 음성 언어 힌트. 한국어 영상만 다룬다면 ko 를 넣으면 인식이 조금 더 안정적이다. 비우면 자동 판별.
STT_LANGUAGE=
WORK_DIR=./workdir

# 영상 길이 상한(초). 기본 5400 = 90분.
# 길수록 비용과 시간이 크게 늘어난다.
MAX_DURATION_SEC=5400

# OCR 로 인식할 최대 프레임 수. 영상이 길면 간격이 자동으로 늘어난다.
# 올리면 더 촘촘히 보지만 그만큼 느려진다.
MAX_OCR_FRAMES=300
OCR_LANG=korean
